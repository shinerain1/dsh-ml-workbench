{
  "protocol_version": 1,
  "schemas": {
    "rpc": {
      "$defs": {
        "DshContext": {
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "maxLength": 512,
              "minLength": 1,
              "title": "Session Id",
              "type": "string"
            },
            "call_id": {
              "maxLength": 512,
              "minLength": 1,
              "title": "Call Id",
              "type": "string"
            }
          },
          "required": [
            "session_id",
            "call_id"
          ],
          "title": "DshContext",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "expected_backend_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Backend Version"
        },
        "operation": {
          "enum": [
            "health",
            "resume",
            "create",
            "run",
            "wait",
            "finalize",
            "start",
            "get",
            "list",
            "cancel",
            "branch",
            "compare",
            "export",
            "inspect",
            "diff",
            "predict",
            "search_create",
            "search_step",
            "search_get",
            "search_cancel"
          ],
          "title": "Operation",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "dsh_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/DshContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation"
      ],
      "title": "RpcRequest",
      "type": "object"
    },
    "create": {
      "$defs": {
        "Preprocessing": {
          "additionalProperties": false,
          "properties": {
            "numeric_imputer": {
              "default": "median",
              "enum": [
                "median",
                "mean",
                "most_frequent"
              ],
              "title": "Numeric Imputer",
              "type": "string"
            },
            "scale_numeric": {
              "default": true,
              "title": "Scale Numeric",
              "type": "boolean"
            },
            "max_categories": {
              "default": 64,
              "maximum": 4096,
              "minimum": 2,
              "title": "Max Categories",
              "type": "integer"
            },
            "drop_columns": {
              "items": {
                "type": "string"
              },
              "title": "Drop Columns",
              "type": "array"
            }
          },
          "title": "Preprocessing",
          "type": "object"
        },
        "SplitSpec": {
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "default": "random",
              "enum": [
                "random",
                "group",
                "time"
              ],
              "title": "Strategy",
              "type": "string"
            },
            "column": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Column"
            }
          },
          "title": "SplitSpec",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "dataset_path": {
          "minLength": 1,
          "title": "Dataset Path",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "task": {
          "enum": [
            "classification",
            "regression"
          ],
          "title": "Task",
          "type": "string"
        },
        "name": {
          "default": "experiment",
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "experiment_name": {
          "default": "DSH ML workbench",
          "maxLength": 160,
          "minLength": 1,
          "title": "Experiment Name",
          "type": "string"
        },
        "model": {
          "default": "random_forest",
          "title": "Model",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "preprocessing": {
          "$ref": "#/$defs/Preprocessing"
        },
        "seed": {
          "default": 42,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "test_fraction": {
          "default": 0.2,
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0.0,
          "title": "Test Fraction",
          "type": "number"
        },
        "final_test_fraction": {
          "default": 0.2,
          "exclusiveMaximum": 0.5,
          "minimum": 0.0,
          "title": "Final Test Fraction",
          "type": "number"
        },
        "timeout_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 5,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "split": {
          "$ref": "#/$defs/SplitSpec"
        },
        "preprocessor_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preprocessor Path"
        },
        "estimator_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimator Path"
        },
        "request_key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Key"
        }
      },
      "required": [
        "dataset_path",
        "target",
        "task"
      ],
      "title": "CreateRequest",
      "type": "object"
    },
    "run": {
      "$defs": {
        "Preprocessing": {
          "additionalProperties": false,
          "properties": {
            "numeric_imputer": {
              "default": "median",
              "enum": [
                "median",
                "mean",
                "most_frequent"
              ],
              "title": "Numeric Imputer",
              "type": "string"
            },
            "scale_numeric": {
              "default": true,
              "title": "Scale Numeric",
              "type": "boolean"
            },
            "max_categories": {
              "default": 64,
              "maximum": 4096,
              "minimum": 2,
              "title": "Max Categories",
              "type": "integer"
            },
            "drop_columns": {
              "items": {
                "type": "string"
              },
              "title": "Drop Columns",
              "type": "array"
            }
          },
          "title": "Preprocessing",
          "type": "object"
        },
        "SplitSpec": {
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "default": "random",
              "enum": [
                "random",
                "group",
                "time"
              ],
              "title": "Strategy",
              "type": "string"
            },
            "column": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Column"
            }
          },
          "title": "SplitSpec",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "dataset_path": {
          "minLength": 1,
          "title": "Dataset Path",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "task": {
          "enum": [
            "classification",
            "regression"
          ],
          "title": "Task",
          "type": "string"
        },
        "name": {
          "default": "experiment",
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "experiment_name": {
          "default": "DSH ML workbench",
          "maxLength": 160,
          "minLength": 1,
          "title": "Experiment Name",
          "type": "string"
        },
        "model": {
          "default": "random_forest",
          "title": "Model",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "preprocessing": {
          "$ref": "#/$defs/Preprocessing"
        },
        "seed": {
          "default": 42,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "test_fraction": {
          "default": 0.2,
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0.0,
          "title": "Test Fraction",
          "type": "number"
        },
        "final_test_fraction": {
          "default": 0.2,
          "exclusiveMaximum": 0.5,
          "minimum": 0.0,
          "title": "Final Test Fraction",
          "type": "number"
        },
        "timeout_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 5,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "split": {
          "$ref": "#/$defs/SplitSpec"
        },
        "preprocessor_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preprocessor Path"
        },
        "estimator_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimator Path"
        },
        "request_key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Key"
        }
      },
      "required": [
        "dataset_path",
        "target",
        "task"
      ],
      "title": "CreateRequest",
      "type": "object"
    },
    "resume": {
      "additionalProperties": false,
      "properties": {
        "previous_session_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Session Id"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "title": "ResumeRequest",
      "type": "object"
    },
    "start": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "RunRequest",
      "type": "object"
    },
    "wait": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "wait_seconds": {
          "default": 30,
          "maximum": 60,
          "minimum": 0,
          "title": "Wait Seconds",
          "type": "integer"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "WaitRequest",
      "type": "object"
    },
    "finalize": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "RunRequest",
      "type": "object"
    },
    "get": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "RunRequest",
      "type": "object"
    },
    "cancel": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "RunRequest",
      "type": "object"
    },
    "list": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "created",
                "starting",
                "running",
                "cancelling",
                "succeeded",
                "failed",
                "interrupted",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Id"
        }
      },
      "title": "ListRequest",
      "type": "object"
    },
    "branch": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "changes": {
          "additionalProperties": true,
          "title": "Changes",
          "type": "object"
        },
        "reuse_preprocessing": {
          "default": true,
          "title": "Reuse Preprocessing",
          "type": "boolean"
        },
        "request_key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Key"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "BranchRequest",
      "type": "object"
    },
    "compare": {
      "additionalProperties": false,
      "properties": {
        "run_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 2,
          "title": "Run Ids",
          "type": "array"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        }
      },
      "required": [
        "run_ids"
      ],
      "title": "CompareRequest",
      "type": "object"
    },
    "export": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "include_data": {
          "default": false,
          "title": "Include Data",
          "type": "boolean"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "ExportRequest",
      "type": "object"
    },
    "inspect": {
      "additionalProperties": false,
      "properties": {
        "dataset_path": {
          "title": "Dataset Path",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "dataset_path"
      ],
      "title": "InspectRequest",
      "type": "object"
    },
    "diff": {
      "additionalProperties": false,
      "properties": {
        "left_run_id": {
          "title": "Left Run Id",
          "type": "string"
        },
        "right_run_id": {
          "title": "Right Run Id",
          "type": "string"
        }
      },
      "required": [
        "left_run_id",
        "right_run_id"
      ],
      "title": "DiffRequest",
      "type": "object"
    },
    "predict": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "dataset_path": {
          "title": "Dataset Path",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "dataset_path"
      ],
      "title": "PredictRequest",
      "type": "object"
    },
    "search_create": {
      "$defs": {
        "SearchSpace": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "int",
                "float",
                "categorical"
              ],
              "title": "Type",
              "type": "string"
            },
            "low": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Low"
            },
            "high": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "High"
            },
            "step": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Step"
            },
            "log": {
              "default": false,
              "title": "Log",
              "type": "boolean"
            },
            "choices": {
              "anyOf": [
                {
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Choices"
            }
          },
          "required": [
            "type"
          ],
          "title": "SearchSpace",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "study_name": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Study Name",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "search_space": {
          "additionalProperties": {
            "$ref": "#/$defs/SearchSpace"
          },
          "maxProperties": 20,
          "minProperties": 1,
          "title": "Search Space",
          "type": "object"
        },
        "n_trials": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "N Trials",
          "type": "integer"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "seed": {
          "default": 42,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "reuse_preprocessing": {
          "default": false,
          "title": "Reuse Preprocessing",
          "type": "boolean"
        },
        "trial_timeout_seconds": {
          "default": 600,
          "maximum": 86400,
          "minimum": 5,
          "title": "Trial Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "study_name",
        "run_id",
        "search_space"
      ],
      "title": "SearchCreateRequest",
      "type": "object"
    },
    "search_step": {
      "additionalProperties": false,
      "properties": {
        "study_name": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Study Name",
          "type": "string"
        }
      },
      "required": [
        "study_name"
      ],
      "title": "SearchRequest",
      "type": "object"
    },
    "search_get": {
      "additionalProperties": false,
      "properties": {
        "study_name": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Study Name",
          "type": "string"
        }
      },
      "required": [
        "study_name"
      ],
      "title": "SearchRequest",
      "type": "object"
    },
    "search_cancel": {
      "additionalProperties": false,
      "properties": {
        "study_name": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Study Name",
          "type": "string"
        }
      },
      "required": [
        "study_name"
      ],
      "title": "SearchRequest",
      "type": "object"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
