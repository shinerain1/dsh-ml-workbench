{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noImplicitAny": true, "declaration": true,
    "outDir": "lib", "rootDir": "src", "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
